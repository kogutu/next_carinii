# Płatności — wzór konfiguracji. Skopiuj potrzebne wpisy do .env (sekrety tylko tam, nigdy do repo).

# --- Publiczny adres aplikacji (dla webhooków i powrotów z bramek) ---
NEXT_PUBLIC_APP_URL=https://www.example.com

# --- Który white label obsługuje daną metodę ---
# BLIK:        tpay | p24 | off      (p24 = stary przycisk BLIK przez Przelewy24, schowany)
# Google Pay:  tpay | p24 | off
# Karta:       tpay | off            (przekierowanie do panelu Tpay)
# Apple Pay:   tpay | off
# PayPo:       tpay | payu | off
NEXT_PUBLIC_PAY_BLIK=tpay
NEXT_PUBLIC_PAY_GOOGLEPAY=tpay
NEXT_PUBLIC_PAY_CARD=tpay
NEXT_PUBLIC_PAY_APPLEPAY=tpay
# Tryb portfeli: redirect = przekierowanie do panelu Tpay (działa u każdego agenta rozliczeniowego, domyślnie)
#                onsite   = płatność tokenem na naszej stronie
# Google Pay on-site dostępny wg Tpay tylko dla agenta Pekao (Elavon -> zostaw redirect).
# Apple Pay on-site: włączaj dopiero po potwierdzeniu w Tpay, że działa przy Waszym agencie (sandbox używa Pekao, więc go nie sprawdzi).
NEXT_PUBLIC_PAY_GOOGLEPAY_MODE=redirect
NEXT_PUBLIC_PAY_APPLEPAY_MODE=redirect
NEXT_PUBLIC_PAY_PAYPO=tpay
# Szybka płatność (Apple Pay / Google Pay) na karcie produktu i w mini-koszyku: on | off
NEXT_PUBLIC_PAY_EXPRESS=on
# Google Pay on-site przez Przelewy24 (NEXT_PUBLIC_PAY_GOOGLEPAY=p24): id metody Google Pay w P24 (domyślnie 266, do potwierdzenia w panelu P24)
P24_GOOGLEPAY_METHOD_ID=
# Zwykłe przekierowania: on | off
NEXT_PUBLIC_PAY_P24=on
NEXT_PUBLIC_PAY_TPAY=on
NEXT_PUBLIC_PAY_PAYU=off

# --- Tpay ---
# sandbox | production
NEXT_PUBLIC_TPAY_ENV=sandbox
# Klucze Open API: Panel Akceptanta > Integracja > API > Klucze do Open API
TPAY_CLIENT_ID=01KN45CG8HCPNFJFX9XMETG0NR-01KPNAQTC0GCVF2GPZXZTY649J
TPAY_CLIENT_SECRET=6b54ba7f7edc5e1866a67fbdfe478935659f1c36c7a4315cd371fd435b794563
# Tylko dla trybu onsite. Identyfikator sprzedawcy używany przez Google Pay (gatewayMerchantId)
NEXT_PUBLIC_TPAY_MERCHANT_ID=195007

# Tylko dla trybu onsite. Identyfikator z Google Pay & Wallet Console (tylko produkcja)
NEXT_PUBLIC_GOOGLE_MERCHANT_ID=195007
# Opcjonalnie: id kanału PayPo, jeśli nie ma się wykryć automatycznie z /transactions/channels
TPAY_PAYPO_CHANNEL_ID=
# Tylko dla Apple Pay onsite: domena i nazwa wyświetlana; domena musi być dodana w panelu Tpay
APPLE_PAY_DOMAIN=
APPLE_PAY_DISPLAY_NAME=Carinii
# Merchant ID z Apple Developer (Identifiers -> Merchant IDs), np. merchant.carnii
NEXT_PUBLIC_APPLE_MERCHANT_ID=

# --- Oznaczanie zamówienia jako opłaconego w Magento (endpoint PHP, zob. docs/tpay-integration.md) ---
ORDER_MARK_PAID_URL=https://sklep.carinii.com.pl/directseo/nextjs/orders/markPaid.php
ORDER_MARK_PAID_TOKEN=
# 1 = tryb próbny: markPaid.php waliduje, ale niczego nie księguje w Magento (do testów na produkcyjnym sklepie)
ORDER_MARK_PAID_DRY_RUN=

# --- Konto klienta i zwroty/reklamacje (skrypty PHP w directseo/nextjs/user i /returns) ---
# Token zaufania Next.js -> PHP (ten sam co customer_api_token w payment/config.local.php na serwerze Magento).
# Bez niego logowanie i panel klienta nie działają: skrypty PHP odrzucają wywołania bez tokenu.
CUSTOMER_API_TOKEN=
# CUSTOMER_API_URL=https://sklep.carinii.com.pl/directseo/nextjs

# --- Analityka i piksele (ładowane dopiero po zgodzie z banera cookies; patrz lib/analytics.ts) ---
# Domyślnie działają tylko na sklep.carinii.com.pl. Na innych adresach (staging, Vercel) są wyłączone,
# chyba że ustawisz NEXT_PUBLIC_ANALYTICS=on. Do testów bez wysyłki do Google/Meta:
#   localStorage.setItem('carinii_analytics_debug', 'log')  -> zdarzenia w konsoli i w window.__analyticsLog
NEXT_PUBLIC_ANALYTICS=
# Domyślne wartości = identyfikatory z obecnego sklepu Magento; ustawiaj tylko, żeby je nadpisać
NEXT_PUBLIC_GA_IDS=G-9CTP8TYMND,G-7F1MNRXVP8
NEXT_PUBLIC_ADS_ID=AW-730929499
NEXT_PUBLIC_ADS_CART_LABELS=RPrWCIqyyIEYENuyxNwC,7l-hCK_YzoEYENuyxNwC
# Etykieta konwersji „zakup” z Google Ads (opcjonalna; bez niej zakupy trafiają do Ads przez import z GA4)
NEXT_PUBLIC_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=282334045919886
